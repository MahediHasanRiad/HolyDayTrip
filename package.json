{
    "name": "holydaytrip-api",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "HolyDayTrip weekend-hotel marketplace API",
    "engines": {
        "node": ">=22.18.0"
    },
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node dist/server.js",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "prisma:generate": "prisma generate",
        "prisma:migrate:dev": "prisma migrate dev",
        "prisma:migrate:deploy": "prisma migrate deploy"
    },
    "dependencies": {
        "@prisma/adapter-pg": "7.10.0",
        "@prisma/client": "7.10.0",
        "cors": "2.8.5",
        "dotenv": "16.6.1",
        "express": "5.2.1",
        "express-rate-limit": "8.7.0",
        "helmet": "8.1.0",
        "pg": "8.16.3",
        "redis": "5.9.0",
        "zod": "4.3.6"
    },
    "devDependencies": {
        "@eslint/js": "9.39.1",
        "@types/cors": "2.8.19",
        "@types/express": "5.0.6",
        "@types/node": "22.19.11",
        "@types/pg": "8.15.6",
        "@types/supertest": "6.0.3",
        "eslint": "9.39.1",
        "eslint-config-prettier": "10.1.8",
        "globals": "16.5.0",
        "prettier": "3.6.2",
        "prisma": "7.10.0",
        "supertest": "7.1.4",
        "tsx": "4.21.0",
        "typescript": "5.9.3",
        "typescript-eslint": "8.46.4",
        "vitest": "4.0.15"
    }
}

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum ReservationStatus {
  PENDING
}

model Owner {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(120)
  email     String   @unique @db.VarChar(320)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  hotels Hotel[]

  @@map("owners")
}

model Hotel {
  id          String   @id @default(uuid()) @db.Uuid
  ownerId     String   @db.Uuid
  name        String   @db.VarChar(180)
  location    String   @db.VarChar(180)
  description String   @db.Text
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  owner Owner @relation(fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  rooms Room[]

  @@index([ownerId])
  @@index([location])
  @@map("hotels")
}

model Room {
  id        String   @id @default(uuid()) @db.Uuid
  hotelId   String   @db.Uuid
  name      String   @db.VarChar(120)
  capacity  Int
  amenities String[] @default([])
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  hotel Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  offers Offer[]

  @@unique([hotelId, name])
  @@index([hotelId])
  @@map("rooms")
}

model Offer {
  id        String   @id @default(uuid()) @db.Uuid
  roomId    String   @db.Uuid
  price     Decimal  @db.Decimal(12, 2)
  currency  String   @db.Char(3)
  checkIn   DateTime @db.Date
  checkOut  DateTime @db.Date
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  room         Room          @relation(fields: [roomId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  reservations Reservation[]

  @@index([roomId])
  @@index([checkIn])
  @@index([checkIn, checkOut])
  @@map("offers")
}

model Reservation {
  id                 String            @id @default(uuid()) @db.Uuid
  offerId            String            @db.Uuid
  customerName       String            @db.VarChar(120)
  customerEmail      String            @db.VarChar(320)
  status             ReservationStatus @default(PENDING)
  hotelNameSnapshot  String            @db.VarChar(180)
  roomNameSnapshot   String            @db.VarChar(120)
  priceSnapshot      Decimal           @db.Decimal(12, 2)
  currencySnapshot   String            @db.Char(3)
  checkInSnapshot    DateTime          @db.Date
  checkOutSnapshot   DateTime          @db.Date
  createdAt          DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime          @updatedAt @db.Timestamptz(6)

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([offerId])
  @@index([customerEmail])
  @@map("reservations")
}

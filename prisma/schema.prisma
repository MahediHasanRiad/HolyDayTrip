generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum IdentityProvider {
  GOOGLE
}

enum OtpPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  name            String    @db.VarChar(120)
  email           String    @unique @db.VarChar(320)
  password        String?   @db.VarChar(255)
  contact         String?   @db.VarChar(11)
  emailVerifiedAt DateTime? @db.Timestamptz(6)

  isActive      Boolean            @default(true)
  createdAt     DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @db.Timestamptz(6)
  hotels        Hotel[]
  reservations  Reservation[]
  identities    ProviderIdentity[]
  sessions      Session[]
  otpChallenges OtpChallenge[]

  @@map("users")
}

model ProviderIdentity {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @db.Uuid
  provider        IdentityProvider
  providerSubject String           @db.VarChar(255)
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@map("provider_identities")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String    @unique @db.VarChar(64)
  expiresAt        DateTime  @db.Timestamptz(6)
  revokedAt        DateTime? @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(6)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model OtpChallenge {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String     @db.Uuid
  purpose    OtpPurpose
  codeHash   String     @db.VarChar(64)
  expiresAt  DateTime   @db.Timestamptz(6)
  attempts   Int        @default(0)
  consumedAt DateTime?  @db.Timestamptz(6)
  createdAt  DateTime   @default(now()) @db.Timestamptz(6)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, expiresAt])
  @@map("otp_challenges")
}

model Hotel {
  id          String   @id @default(uuid()) @db.Uuid
  ownerId     String   @db.Uuid
  name        String   @db.VarChar(180)
  district    String   @db.VarChar(100)
  location    String   @db.VarChar(180)
  latitude    String?
  longitude   String?
  description String   @db.Text
  images      String[] @default([])
  Facilities  String[] @default([])
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  owner User   @relation(fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  rooms Room[]

  @@index([ownerId])
  @@index([location])
  @@index([district])
  @@map("hotels")
}

model Room {
  id              String   @id @default(uuid()) @db.Uuid
  hotelId         String   @db.Uuid
  name            String   @db.VarChar(120)
  capacity        Int
  bedType         String
  viewType        String
  roomSize        String
  images          String[] @default([])
  amenities       String[] @default([])
  regularPrice    Decimal  @db.Decimal(12, 2)
  discountedPrice Decimal  @db.Decimal()
  currency        String   @db.Char(3)
  checkIn         DateTime @db.Date
  checkOut        DateTime @db.Date
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([hotelId, name])
  @@index([hotelId])
  @@map("rooms")
}

model Reservation {
  id         String            @id @default(uuid()) @db.Uuid
  roomId     String            @db.Uuid
  customerId String            @db.Uuid
  status     ReservationStatus @default(PENDING)
  createdAt  DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime          @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([roomId])
  @@index([customerId])
  @@map("reservations")
}
